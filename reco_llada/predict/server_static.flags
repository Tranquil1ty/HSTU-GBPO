#!/bin/bash
--log_dir=../log/

--grpc_server_port=9082
--grpc_thread_num=184
--web_thread_num=8
--web_server_port=9080

################# BEGIN REGION DICT #################
--ip_region_dict_file=../data/ip_region.dat
--region_searcher_point_file=../data/geography.data
--region_dict_filename=../data/region_dict.dat
--dnn_cluster_id_map_file=../data/dnn_cluster_map_file_name.dat
################# END REGION DICT #################

# sample
--use_bt_queue_sample=true

# perf 开关
--perfutil_product_env=true

# debug 页面
--common_reco_request_detail_interval_ts=10000000

# leaf show
--common_reco_enable_leaf_show=false

# for mio predict
--mio_tensorflow_executor_session_per_device=4
--mio_tensorflow_gpu_device_memory_mb=2048
--dnn_local_path=/dev/shm/dnn_model/
--mio_embedding_enable_cache=true
--mio_embedding_cache_version=1
--mio_embedding_skip_cache_ratio=0.06
--embedding_cache_dirs=/dev/shm/embedding_cache
--embedding_cache_capacity=10000000

# cache response
--request_cache_kcc_cluster=recoModelUserRequestCache
--enable_request_cache=true
--request_cache_user_whitelist_kconf_key=reco.model.exploreCacheWhitelist
--enable_response_cache=true
--response_cache_user_whitelist_kconf_key=reco.model.exploreCacheWhitelist
--response_cache_limit_for_user=30

# boot faster, by load model 10 minutes before
--online_dnn_model_trainer_output_delta_model=false
--online_dnn_model_trainer_output_batch_model_period_us=600000000

# distributed index
--item_doc_grpc_service_name=grpc_hotPhotoInfoService
--item_doc_cache_realtime_queue_name=exp_realtime_photoinfo
--kconf_item_num_limit_path=reco.distributedIndex.hotItemDocNumLimiter
--item_doc_cache_size=15000000
--item_doc_cache_grpc_timeout_ms=300
--item_doc_cache_ttl_sec=600
--item_doc_dump_interval_sec=900
--item_doc_cache_put_thread_num=4
--item_doc_grpc_io_thread_num=16
--item_doc_using_f14_lru=true
--item_doc_has_important_queue=false
--item_doc_dump_file_name=./no-such-dir/item_doc.binlog
--item_doc_dump_file_expire_sec=3600

# record traffic for dryrun
--traffic_record_biz_name=reco
--traffic_record_prefer_kws_biz_name=false

--logging_switch_uid_mod_divisor=999

# stop faster
--enable_fast_stop=true

# make kuiba to extract signs like mio
--embedding_warmup_with_mio_model=true
--parameter_sign_bits=48

# for transformer
--userprofilev1_realshow_list_num=50

# enable grpc and brpc
--server_type=grpc

# more event loop
#--kess_client_event_loop_nums=64
#--kess_client_client_nums=8
--kess_client_event_loop_nums=32

# tensorrt
--trt_per_layer_profiling_step=1
--trt_predict_total_step=1
--trt_cuda_stream_time_cost=false
--trt_max_batching_size_config=512
--trt_serving_batching_system_batch_size=512
--max_item_size_per_req=1024
--max_concurrency=145
--reserve_factor=3

--tensor_meta_max_batch_size=1024
--save_graph_flag=false

--trt_compute_context_num=4
--trt_batch_compute_thread_num=10
--trt_batch_prepare_thread_num=36
--trt_scheduler_queue_num=1

--trt_batch_timeout_micros=10000
--trt_is_batching_compute_async=true
--trt_refit_enable=true
--enable_trt_per_layer_profiling=false

--grpc_caller_whitelist_kconf_key=reco.model.exploreCommonLeafWhitelist

--extract_sign_user_deviceid_hetutag_level=1

--min_embeddings_required=0
--sync_embeddings_from_replica=false
--shm_embd_memory=10737418240
--shm_embd_capacity=100000

# no speed limit for btq
--base_bt_queue_client_push_limit=-1

--dragon_grpc_use_multi_eventloop=true

--mio_embedding_trained_by_kai=true

--kess_weight_baseline_for_cpu_benchmark=1000
--machine_type_cpu_mark_kconf_key=

--colossus_common_item_compress_type=0

# less thread for sub_flow
--use_global_sub_flow_thread_pool=true
--sub_flow_async_thread_num=10
--sub_flow_async_thread_num_ratio=0.5
--sub_flow_thread_num_upscale_ratio=1

# more thread for embedding fetcher
--uni_embedding_manager_thread_pool_size_per_fetcher=128
--tensorrt_executor_ctx_per_gpu_device=15
--use_cuda_graph_memcpy=true
--embedding_fetcher_thread_num=512

# init faster
#--parallel_init_processor_concurrency=4
#--parallel_init_processor=true
--parallel_init_processor=false
--parallel_init_pipeline_concurrency=16
--parallel_init_processor_concurrency=0

--colossus_common_item_timeout_ms=50

--local_fetch_embedding_ignore_size=true
--enable_reduce_useless_sum_pooling_memset=true
--enable_memcpy_for_repeat_sign=true
--batching_enable_split_task=true
