          "import_common_attr": [
            "trigger_string"
          ],
          "lua_script": "function stringToIntArray()\n                local photo_id_list = {}\n                for pid_str in string.gmatch(trigger_string, \"[^,]+\") do\n                    local pid = tonumber(pid_str)\n                    if pid then\n                        table.insert(photo_id_list, pid)\n                    end\n                end\n                return photo_id_list\n            end",
          "type_name": "CommonRecoLuaAttrEnricher"
        },
