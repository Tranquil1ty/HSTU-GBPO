          "import_item_attr": [
            "long_play_count",
            "show_count"
          ],
          "lua_script": "function calc()\n                local is_lv = 1;\n                local lv_rate = long_play_count/show_count;\n                if (lv_rate < select_lv_rate_threshold) or (show_count < select_show_count_threshold) then\n                    is_lv = 0;\n                end \n                return is_lv, lv_rate;\n            end",
          "type_name": "CommonRecoLuaAttrEnricher"
        },
