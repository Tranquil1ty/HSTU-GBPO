#!/bin/bash
--log_dir=../log/

--grpc_server_port=9082
--grpc_thread_num_per_core=2.0
--web_thread_num=12
--web_server_port=9080

################# BEGIN REGION DICT #################
--ip_region_dict_file=../data/ip_region.dat
--region_searcher_point_file=../data/geography.data
--region_dict_filename=../data/region_dict.dat
################# END REGION DICT #################

# sample
--use_bt_queue_sample=true

# perf 开关
--perfutil_product_env=true

# debug 页面
--common_reco_request_detail_interval_ts=10000000

# leaf show
--common_reco_enable_leaf_show=false

# btq 限速
#--base_bt_queue_client_push_limit=1600000000
--base_bt_queue_client_push_limit=-1
--btq_buffer_batch_size=64

# less log
--logging_switch_uid_mod_divisor=2000
--shard_request_async_thread_num=128


# more event loop
--kess_client_event_loop_nums=32
--dragon_grpc_use_multi_eventloop=true

# stop faster
--enable_fast_stop=true