--log_dir=../log/

--logging_switch_uid_mod_divisor=1000

#--attr_index_queue_names=reco_index_transfer_hotPhoto_commonIndex,reco_index_transfer_hotPhoto_commonIndex(important)
#--attr_index_btq_reader_name=grpc_mmu_e2e_i2i_v0
#--attr_index_capacity=1073741824
#--attr_index_memory=200000000000
#--attr_index_expire_seconds=86400
#--attr_index_biz_name=grpc_mmu_e2e_i2i_v0
#--attr_index_bt_shm_kv_kess_name=grpc_hotPhotoInfo_CommonIndex_For_ANN
#--attr_index_bt_sync_shard_name=grpc_hotPhotoInfo_CommonIndex_For_ANN_BTSync
#--attr_index_bt_sync_skip_no_other_client=false
#--recycle_force_renew=true
#--attr_index_btq_threads_num=2
#--attr_index_start_max_btq_lag=3600

--base_bt_queue_use_native_hdfs_client=true

# more event loop
--kess_client_event_loop_nums=32
--dragon_grpc_use_multi_eventloop=true

# stop faster
--enable_fast_stop=true
--attr_perf_sample_rate=0.001


# 开启 handler 的并行初始化，缩短服务冷启动耗时
# --parallel_init_processor=true

# 开启 pipeline 和 processor 的并行初始化，同时让仅配置更新在后台运行，提高更新期间的可用性
# --parallel_init_pipeline_concurrency=16
# --parallel_init_processor_concurrency=32

# for mio predict
--mio_tensorflow_executor_session_per_device=64
--mio_tensorflow_gpu_device_memory_mb=2048
--dnn_local_path=/dev/shm/dnn_model/
--embedding_warmup_with_mio_model=true
--parameter_sign_bits=48

# 性能优化
--enable_numa_aware=true