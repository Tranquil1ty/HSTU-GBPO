
--base_bt_queue_use_native_hdfs_client=true
#--min_embeddings_required=1000000
--embedding_warmup_with_mio_model=true
--parameter_sign_bits=48

--mio_embedding_enable_cache=true
--mio_embedding_cache_version=1
--mio_embedding_skip_cache_ratio=0.06
--embedding_cache_dirs=/dev/shm/embedding_cache
--embedding_cache_capacity=10000000

#--mio_tf_dnn_model_trainer_output_delta_model=false
#--mio_tf_dnn_model_trainer_output_batch_model_period_us=600000000
--mio_tf_save_dnn_model_as_binary=true

--attr_perf_sample_rate=0.001
--btq_frame_size=1000000
--uni_disable_model_update_p1_alert=true


--log_dir=../log/

# 按需添加， bt sync 的线程数量，能加快 bt 同步速度
--bt_shm_kv_sync_concurrency=2

--grpc_thread_num=128
--parallel_ann_thread_num=60

--enable_return_item_without_element=true
--max_shm_mem_size=150000000000

--base_bt_queue_use_native_hdfs_client=true

--logging_switch_uid_mod_divisor=10000
--attr_index_queue_names=reco_index_transfer_hotPhoto_commonIndex,reco_index_transfer_hotPhoto_commonIndex(important)
--attr_index_btq_reader_name=i2i_Bigcode_ann
--attr_index_trim_attr_kconf=rinf.rlRunner.attr_index_boost_search_new_4352_whitelist
--attr_index_capacity=1073741824
--attr_index_memory=150000000000
--attr_index_expire_seconds=86400
--attr_index_biz_name=i2i_Bigcode_ann
--attr_index_bt_shm_kv_kess_name=grpc_hotPhotoInfo_CommonIndex_For_ANN
--attr_index_bt_sync_shard_name=grpc_hotPhotoInfo_CommonIndex_For_ANN_BTSync
--attr_index_bt_sync_skip_no_other_client=false
--recycle_force_renew=true
--attr_index_btq_threads_num=2
--attr_index_shmkv_index_start_kconf=reco.distributedIndex.attrIndexStart
--bt_shm_kv_sync_concurrency=2
--cache_num_mulitple=1

--attr_index_start_max_btq_lag=3600

# gpu ann
#--enable_parallel_batch_query=true
#--reallocate_request_thread_num=2
#--collect_time_out_us=10000
#--request_batch_size_in_single_search=1
#--parallel_batch_ann_max_item_num=4

# 在 request 端设置的 ann 算法参数是否生效，如果所有 request 的 ann 算法参数没有区别，设置成 true 即可
--disable_set_algo_params=true
--local_ann_async_pool_thread_num=64

# more event loop
--kess_client_event_loop_nums=32
--dragon_grpc_use_multi_eventloop=true

# stop faster
--enable_fast_stop=true

--slow_list_length_limit_kconf_key=reco.model2.onerec_rag_slow_list
