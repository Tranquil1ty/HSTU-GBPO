--log_dir=../log/
--grpc_thread_num=100
--base_bt_queue_use_native_hdfs_client=true
--min_embeddings_required=1000000
--embedding_warmup_with_mio_model=true
--parameter_sign_bits=48

--mio_embedding_enable_cache=true
--mio_embedding_cache_version=1
--mio_embedding_skip_cache_ratio=0.06
--embedding_cache_dirs=/dev/shm/embedding_cache
--embedding_cache_capacity=10000000

--mio_tf_save_dnn_model_as_binary=true
--logging_switch_uid_mod_divisor=199

# 先关掉通用索引
# --index_queue=hot_photo_info_for_ann
--attr_index_queue_names=reco_index_transfer_hotPhoto_commonIndex,reco_index_transfer_hotPhoto_commonIndex(important)
# BTQ读取配置，可以随意改
--attr_index_btq_reader_name=list_generate_09b_backup
# 不要改
--attr_index_capacity=1073741824
# 不要改
--attr_index_memory=150000000000
# 可以改，现在是 1 day
--attr_index_expire_seconds=86400
# 必须改，监控用这个名字，一般是 kess 名称
--attr_index_biz_name=list_generate_09b_backup
# 不要改 bt sync 的 kess 名
--attr_index_bt_shm_kv_kess_name=grpc_hotPhotoInfo_CommonIndex_For_ANN
# 不要改
--attr_index_bt_sync_shard_name=grpc_hotPhotoInfo_CommonIndex_For_ANN_BTSync
# 启动时没有找到相同实例，是否跳过 bt 同步(一般不要改)
--attr_index_bt_sync_skip_no_other_client=false
# 不要改，MemKv配置
--recycle_force_renew=true
# 按需添加，出现btq lag时配置加速读取
--attr_index_btq_threads_num=2
# 不要改 启动时检查 attr index 配置 （可用于启动时清理 attr index 见附录 ）
--attr_index_shmkv_index_start_kconf=reco.distributedIndex.attrIndexStart
# 按需添加， bt sync 的线程数量，能加快 bt 同步速度
--bt_shm_kv_sync_concurrency=2
# 防止 attr index lag 太大 block
--attr_index_start_max_btq_lag=30
# attr_index 裁剪白名单
--attr_index_trim_attr_kconf=rinf.rlRunner.attr_index_diffurec_whitelist